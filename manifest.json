{
  "manifest_version": 3,
  "name": "Youtube Hands Free",
  "version": "1.0.0",
  "description": "Hardware-level clicker with Premium UI and Fast-Forward.",
  "permissions": ["debugger", "tabs", "scripting", "storage"],
  "host_permissions": ["*://*.youtube.com/*"],
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Youtube Hands Free"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
