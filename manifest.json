{
  "manifest_version": 3,
  "name": "Youtube Hands Free",
  "version": "1.3.0",
  "description": "Hardware-level YouTube ad skipper with AI Voice Control, 4K Stream Lock & Live Animated Icon.",
  "permissions": ["debugger", "tabs", "scripting", "storage"],
  "host_permissions": ["*://*.youtube.com/*"],
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Youtube Hands Free",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
